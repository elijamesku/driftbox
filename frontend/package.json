    "monaco-editor": "^0.54.0",
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-diff-viewer-continued": "^3.4.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-mermaid2": "^0.1.0",
    "reactflow": "^11.10.4",
    "recharts": "^3.7.0",
    "tailwind-merge": "^2.6.0",
    "tree-sitter-hcl": "^0.0.1-security",
    "vscode-icons-js": "^11.6.1",
    "web-tree-sitter": "^0.25.10"
  },
