{
  "name": "driftbox-desktop",
  "version": "1.0.0",
  "author": "Driftbox Inc.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "dev:clean:win": "if exist .next rmdir /s /q .next && next dev",
    "dev:electron": "cross-env NODE_ENV=development electron electron/main.js",
    "build": "next build",
    "build:electron": "bash build-dmg-optimized.sh",
    "build:mac": "bash build-dmg-optimized.sh",
    "build:win": "build-electron.bat",
    "build:linux": "bash build-dmg-optimized.sh && electron-builder --linux",
    "build:all": "bash build-dmg-optimized.sh && electron-builder -mwl",
    "start": "next start",
    "lint": "next lint",
    "electron": "electron electron/main.js",
    "clean": "rm -rf .next",
    "clean:win": "if exist .next rmdir /s /q .next"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-separator": "^1.1.1",
